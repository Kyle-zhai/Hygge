# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM fallback chain — same shape as worker/.env.example. Next.js only reads
# these for local recommend/preview flows; the production worker on Railway
# owns the real chain. Users with BYOK save a chain via /settings/llm instead,
# which overrides these env defaults per-request.
#
# Up to 10 entries (LLM_1_* through LLM_10_*). Each group:
#   LLM_N_PROVIDER       openai_compatible | anthropic | google
#   LLM_N_API_KEY        required
#   LLM_N_MODEL          required
#   LLM_N_BASE_URL       required for openai_compatible
#   LLM_N_VISION_MODEL   optional
#   LLM_N_LABEL          optional

LLM_1_PROVIDER=openai_compatible
LLM_1_API_KEY=your-mimo-key
LLM_1_MODEL=mimo-v2.5-pro
LLM_1_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_1_VISION_MODEL=mimo-v2-omni

# Encryption secret for BYOK API keys saved via /settings/llm. Any string
# ≥16 chars; SHA-256 is applied internally. Generate: openssl rand -base64 32
LLM_KEY_ENCRYPTION_SECRET=

# Redis (Worker)
REDIS_URL=redis://localhost:6379

# Worker HTTP proxy (for endpoints that need DashScope access from overseas Vercel)
WORKER_URL=https://your-worker.up.railway.app
WORKER_SHARED_SECRET=change-me-shared-with-worker

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_MAX_PRICE_ID=price_...

# Admin panel — comma-separated emails allowed to access /admin
# Empty = no one can access (deny by default)
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Optional — the app boots without these
# ---------------------------------------------------------------------------

# Upstash REST credentials, used by the rate limiter. Without them rate
# limiting is skipped (fine locally, not in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tavily web search — enables source-cited findings in the mechanisms that
# ground against real-world data. Without it those findings say "no
# authoritative source found". Get a key at https://tavily.com.
TAVILY_API_KEY=

# Shared secret for the Vercel cron endpoints (/api/cron/*). Vercel sends it
# as `Authorization: Bearer $CRON_SECRET`. Generate: openssl rand -hex 32
CRON_SECRET=

# Product analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe free-trial length in days. Unset or 0 = no trial.
STRIPE_TRIAL_DAYS=

# Feature flag — set to "true" to expose the persona publications surface.
NEXT_PUBLIC_ENABLE_PUBLICATIONS=
